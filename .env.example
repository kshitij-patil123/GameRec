# Copy to .env and edit. Never commit .env.
DATA_SOURCE=demo                # demo | public | discord_export
DATABASE_URL=postgresql+psycopg2://gamerec:change_me@localhost:5432/gamerec
POSTGRES_USER=gamerec
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gamerec
CORS_ORIGINS=http://localhost:5173
# Salt used to hash Discord author IDs before storing (privacy). Set a random string.
USER_HASH_SALT=change_me_random_string
RANDOM_SEED=42
# Token for POST /system/refresh (rebuild recommender after a data refresh). Empty = endpoint disabled.
ADMIN_TOKEN=
